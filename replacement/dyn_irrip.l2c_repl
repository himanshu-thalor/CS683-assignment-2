#include "cache.h"

#define maxRRPV 3
#define LEADERS 64     // 64 leader sets dedicated to sampling (stride 16)
#define THRESHOLD 0.25 // instruction ratio threshold to activate irrip mode


uint32_t l2_rrpv[L2C_SET][L2C_WAY];
uint8_t l2_is_instruction[L2C_SET][L2C_WAY]; // 1 if block is an instruction, 0 for data


// access and miss counters tracked on leader sets
uint64_t instr_acc , instr_miss ;
uint64_t data_acc , data_miss ;
bool use_irrip = false; // dynamic flag deciding whether follower sets use irrip

// check if a set is one of our dedicated leader sets
static inline bool is_leader(uint32_t set)
{
    return (set % (L2C_SET / LEADERS)) == 0;
}


// initialize replacement state
void CACHE::l2c_initialize_replacement()
{
    cout << "Initialize SRRIP state for L2C" << endl;
    instr_acc = instr_miss = 0;
    data_acc = data_miss = 0;
    use_irrip = false;

    for (int i=0; i<L2C_SET; i++) {
        for (int j=0; j<L2C_WAY; j++) {
            l2_rrpv[i][j] = maxRRPV;
            l2_is_instruction[i][j] = 0;
        }
    }
}

// find replacement victim
uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    // look for an invalid line first
    for (int i = 0; i < L2C_WAY; i++) {
        if (current_set[i].valid == 0)
            return i;
    }

    // only follower sets adapt; leader sets always stay on standard RRIP
    bool irrip = use_irrip && !is_leader(set);

    while (1)
    {
        if (irrip) {
            // first look for data lines at maxRRPV to protect instruction lines
            for (int i = 0; i < L2C_WAY; i++)
                if (l2_rrpv[set][i] == maxRRPV &&
                    !l2_is_instruction[set][i])
                    return i;
            // next check data lines at RRPV=2 before evicting instructions
            for (int i = 0; i < L2C_WAY; i++)
                if (l2_rrpv[set][i] == (maxRRPV - 1) &&
                    !l2_is_instruction[set][i])
                    return i;
        }

        // normal SRRIP: pick any line with maxRRPV
        for (int i = 0; i < L2C_WAY; i++)
            if (l2_rrpv[set][i] == maxRRPV)
                return i;

        // age all lines if no victim candidate was found
        for (int i = 0; i < L2C_WAY; i++)
            if (l2_rrpv[set][i] < maxRRPV)
                l2_rrpv[set][i]++;
    }

    // WE SHOULD NOT REACH HERE
    assert(0);
    return 0;
}

// called on every cache hit and cache fill
void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    // sample instruction pressure on leader sets (ignore prefetches)
    if (is_leader(set) && type != PREFETCH) {
        if (isInstruction) {
            instr_acc++;
            if (!hit) instr_miss++;
        } else {
            data_acc++;
            if (!hit) data_miss++;
        }

        uint64_t instruction_count = instr_acc + instr_miss;
        uint64_t total_count = instruction_count
                            + data_acc + data_miss;

        // if instruction activity is higher than threshold, turn on irrip
        if (total_count > 0) {
            double score = (double)instruction_count / total_count;
            use_irrip = (score > THRESHOLD);
        }
    }
    string TYPE_NAME;
    if (type == LOAD)
        TYPE_NAME = "LOAD";
    else if (type == RFO)
        TYPE_NAME = "RFO";
    else if (type == PREFETCH)
        TYPE_NAME = "PF";
    else if (type == WRITEBACK)
        TYPE_NAME = "WB";
    else if (type == LOAD_TRANSLATION)
	TYPE_NAME = "L_TN";
    else if (type == PREFETCH_TRANSLATION)
	TYPE_NAME = "P_TN";
    else if (type == TRANSLATION_FROM_L1D)
	TYPE_NAME = "TN_L1D";
    else
        assert(0);

    if (hit)
        TYPE_NAME += "_HIT";
    else
        TYPE_NAME += "_MISS";

    if ((type == WRITEBACK) && ip)
        assert(0);

    // uncomment this line to see the L2C accesses
    // cout << "CPU: " << cpu << "  L2C " << setw(9) << TYPE_NAME << " set: " << setw(5) << set << " way: " << setw(2) << way;
    // cout << hex << " paddr: " << setw(12) << paddr << " ip: " << setw(8) << ip << " victim_addr: " << victim_addr << dec << endl;
    
    bool irrip = use_irrip && !is_leader(set);

    if (hit) {
        // prefetches get intermediate priority, demand hits get top priority
        if (type == PREFETCH)
            l2_rrpv[set][way] = maxRRPV - 1;
        else if (irrip && !isInstruction)
            l2_rrpv[set][way] = 1;
        else
            l2_rrpv[set][way] = 0;
    } else {
        // speculative prefetches insert distant (3); instructions insert near-immediate (1)
        if (type == PREFETCH)
            l2_rrpv[set][way] = maxRRPV;
        else if (irrip && isInstruction)
            l2_rrpv[set][way] = 1;
        else
            l2_rrpv[set][way] = maxRRPV - 1;
    }

    l2_is_instruction[set][way] = isInstruction; // save block type for victim selection
}

// use this function to print out your own stats at the end of simulation
void CACHE::l2c_replacement_final_stats()
{

}