#include "cache.h"
#include <iostream>

// CS683 PA2 - Task 1B: Stride Pattern Prefetcher (SPP) at L1D
//
// We track every load IP in a 4-way IP table. If the IP keeps repeating the
// same stride (u_conf >= 1) we prefetch with that stride(uniform mode) , else we go
// back to a pattern table (PHT)(non-uniform mode), having indexing as a signature of the IP's recent
// strides, which tells about the next stride. Prefetches stay inside the 4KB page, a
// small FIFO filter filters repeated requests, and the degree (1/2/4/6/8)
// is decided by the prefetch accuracy of the last 128 useful + useless prefetches.
//
// Storage (also mentioned in the report):
//   IP entry : tag 16 + valid 1 + last_cl 58 + last_stride 8 + u_conf 2
//              + sig 10 + lru 2 + pf_off 6 + pf_valid 1 = 104 bits
//              x 1024 entries = 106,496 bits
//   PHT entry: stride 8 + conf 2 = 10 bits x 1024 entries = 10,240 bits
//   Filter   : 32 x 64-bit line address = 2,048 bits
//   Throttler: useful snapshot 16 + useless snapshot 16 + degree level 3 = 35 bits
//   TOTAL    : 118,819 bits = 14.504 KB
//   Not counted: the 5-bit filter head pointer 
//   and the per-line "prefetched" bit the L1D already keeps.

#define IP_SETS     256
#define IP_WAYS     4
#define PHT_SIZE    1024
#define FILTER_SIZE 32

struct IP_ENTRY {
    uint16_t tag;
    uint8_t  valid;
    uint64_t last_cl;       // last cache line this IP touch
    int8_t   last_stride;
    uint8_t  u_conf;        // 0..3, confidence in last_stride
    uint16_t sig;           // history of the last few strides
    uint8_t  lru;           // 0 = most recently used
    uint8_t  pf_off;        // farthest line already prefetched in this page
    uint8_t  pf_valid;      // checking if pf_off valid for the current page
};

struct PHT_ENTRY {          
    int8_t  stride;
    uint8_t conf;          
};

static IP_ENTRY  ip_table[IP_SETS][IP_WAYS];
static PHT_ENTRY pht[PHT_SIZE];
static uint64_t  filter[FILTER_SIZE];   // recently prefetched lines 
static int       filter_head = 0;

static int degree = 4;
static uint64_t last_useful = 0, last_useless = 0;  // cache counters at the last degree update

// updating the signature by shifting the old history by 2 bits and mixing the new stride (sign + 6-bit magnitude)
static int update_sig(int sig, int stride) {
    int size = stride;
    if (stride < 0) size = -stride;

    int token = size & 0x3F;
    if (stride < 0) token = token | 0x40;

    return ((sig << 2) ^ token) & (PHT_SIZE - 1);
}

// Making one way the most recently used in its set
static void make_mru(int set, int way) {
    for (int w = 0; w < IP_WAYS; w++)
        if (ip_table[set][w].lru < ip_table[set][way].lru) 
            ip_table[set][w].lru++;
    ip_table[set][way].lru = 0;
}

void CACHE::l1d_prefetcher_initialize() {
    std::cout << "CPU " << cpu << " L1D Stride Pattern Prefetcher (SPP)" << std::endl;
    for (int i = 0; i < IP_SETS; i++)
        for (int j = 0; j < IP_WAYS; j++)
            ip_table[i][j].lru = j;     // everything else is static, so already zero
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag) {
    if (type == PREFETCH || type == WRITEBACK || ip == 0) return;

    // The cache counters restarts after warmup, so correct it before subtracting
    if (pf_useful < last_useful || pf_useless < last_useless) {
        last_useful  = pf_useful;
        last_useless = pf_useless;
    }

    // Picking the degree from the accuracy of the last 128 prefetch outcomes
    uint64_t useful  = pf_useful  - last_useful;
    uint64_t useless = pf_useless - last_useless;
    if (useful + useless >= 128) {
        int acc = (int)(useful * 100 / (useful + useless));
        if (acc < 42)      degree = 1;
        else if (acc < 50) degree = 2;
        else if (acc < 65) degree = 4;
        else if (acc < 80) degree = 6;
        else               degree = 8;
        last_useful  = pf_useful;
        last_useless = pf_useless;
    }

    uint64_t cl     = addr >> LOG2_BLOCK_SIZE;
    uint64_t page   = addr >> LOG2_PAGE_SIZE;
    int      offset = (int)(cl & 63);                   
    uint32_t set    = (uint32_t)((ip ^ (ip >> 5) ^ (ip >> 11) ^ (ip >> 17)) & (IP_SETS - 1));
    uint16_t tag    = (uint16_t)((ip >> 8) & 0xFFFF);

    // Look for this IP in its set
    int way = -1;
    for (int w = 0; w < IP_WAYS; w++)
        if (ip_table[set][w].valid && ip_table[set][w].tag == tag) { way = w; break; }

    if (way == -1) {
        // new IP so use a free way, otherwise the least recently used one
        way = 0;
        for (int w = 0; w < IP_WAYS; w++) {
            if (!ip_table[set][w].valid) { way = w; break; }
            if (ip_table[set][w].lru == IP_WAYS - 1) way = w;
        }
        IP_ENTRY &n = ip_table[set][way];
        n.valid = 1;  n.tag = tag;  n.last_cl = cl;
        n.last_stride = 0;  n.u_conf = 0;  n.sig = 0;  n.pf_off = 0;  n.pf_valid = 0;
        make_mru(set, way);
        return;
    }
    make_mru(set, way);
    IP_ENTRY &e = ip_table[set][way];

    if (page != (e.last_cl >> 6)) {
        // new page so keep using the old stride, but only if we were confident in it
        e.last_cl  = cl;
        e.pf_valid = 0;
        if (e.u_conf < 2) return;
    } else {
        int stride = offset - (int)(e.last_cl & 63);
        if (stride == 0) return;                        // same cache line

        // uniform stride so a mismatch drops confidence to 0 so the IP falls back to the PHT
        if (stride == e.last_stride) {
            if (e.u_conf < 3) e.u_conf++;
        } else {
            e.u_conf = 0;
            e.pf_valid = 0;
            e.last_stride = stride;
        }

        // train the PHT: old signature -> this stride
        PHT_ENTRY &p = pht[e.sig];
        if (p.stride == stride) {
            if (p.conf < 3) p.conf++;
        } else {
            if (p.conf > 0) p.conf--;
            if (p.conf == 0) p.stride = stride;
        }

        e.sig = update_sig(e.sig, stride);
        e.last_cl = cl;
    }

    // Prefetch loop. Uniform mode uses line + stride * d, otherwise we follow
    // the PHT one predicted stride after another.
    uint64_t page_base = page << 6;
    bool uniform = (e.u_conf >= 1);
    int cur = offset;           // position of the last predicted line (PHT mode)
    int s = e.sig;              // signature we walk forward (PHT mode)

    for (int d = 1; d <= degree; d++) {
        int nxt;

        if (uniform) {
            nxt = offset + e.last_stride * d;
        } else {
            if (pht[s].conf == 0) break;
            int pred = pht[s].stride;
            nxt = cur + pred;
            cur = nxt;
            s = update_sig(s, pred);
        }

        // stop if we leave the 4KB page
        if (nxt < 0 || nxt > 63) break;

        // skip lines already prefetched in this page
        if (uniform && e.pf_valid && ((e.last_stride > 0 && nxt <= e.pf_off) ||
                                      (e.last_stride < 0 && nxt >= e.pf_off)))
            continue;

        uint64_t target = page_base + nxt;

        // checking was this line asked for recently
        bool recent = false;
        for (int i = 0; i < FILTER_SIZE; i++)
            if (filter[i] == target) recent = true;

        if (!recent) {
            // If the MSHR is more than half full, fill into L2 so L1D demand misses are not blocked
            int fill = (MSHR.occupancy * 2 < MSHR.SIZE) ? FILL_L1 : FILL_L2;
            if (!prefetch_line(ip, addr, target << LOG2_BLOCK_SIZE, fill, 0)) break;   // queue full

            filter[filter_head] = target;
            filter_head = (filter_head + 1) % FILTER_SIZE;
        }

        if (uniform) {
            e.pf_off = (uint8_t)nxt;
            e.pf_valid = 1;
        }
    }
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch, uint64_t v_evicted_addr, uint64_t evicted_addr, uint32_t metadata_in) {}

void CACHE::l1d_prefetcher_final_stats() {
    std::cout << "SPP final degree: " << degree << std::endl;
}
